# Cap npm's parallel registry connections.
#
# The self-hosted Forgejo CI runs jobs in containers nested behind a double-NAT
# (forgejo-runner-dind on a Docker compose bridge). On Docker 29 the host NAT
# resets bursts of more than ~10-15 concurrent outbound connections. npm's
# default (maxsockets=15) trips this: `npm ci` fails with "Exit handler never
# called!" (mass ECONNRESET to registry.npmjs.org), surfacing downstream as
# "eslint: not found" / "vitest: not found". Capping concurrency keeps installs
# under the threshold (same root cause documented in the sibling repos).
maxsockets=5
fetch-retries=5
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=60000
